# Variables de entorno de la API (en Render: dashboard -> Environment).
# Para desarrollo local puedes exportarlas en tu shell antes de `npm run api`.
# NUNCA subas un .env real al repositorio.

# Secreto para firmar los tokens de sesion. Genera uno largo y aleatorio, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=86400
AUTH_REQUIRED=true

# Credenciales del admin inicial (solo se usan la primera vez, cuando el
# almacen de usuarios esta vacio).
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=

# Alta publica actual. El registro por correo permanece apagado.
GOOGLE_CLIENT_ID=
REGISTRATION_ENABLED=false

# Origenes permitidos para CORS, separados por coma. Produccion debe enumerar
# exactamente Vercel, localhost y el ID definitivo de la extension; nunca '*'.
CORS_ORIGIN=https://tabulacion.vercel.app,http://localhost:5173,chrome-extension://kdppbednjfajcjogdajmagfabidfjmem
CORS_ALLOWED_ORIGINS=https://tabulacion.vercel.app,http://localhost:5173,chrome-extension://kdppbednjfajcjogdajmagfabidfjmem
CHROME_EXTENSION_ID=kdppbednjfajcjogdajmagfabidfjmem
PUBLIC_BASE_URL=http://localhost:8080

# Neon es la fuente de verdad en produccion. El archivo JSON existe solo como
# backend de desarrollo y tests locales; nunca debe configurarse en Render.
# DATABASE_URL=postgresql://usuario:clave@host/basedatos?sslmode=verify-full
# Prefijo opcional de tablas (los tests usan test_ para no tocar datos reales).
# STORE_TABLE_PREFIX=
# STORE_AUTO_MIGRATE=true
# USER_STORE_PATH=/var/data/users.json
# En producción DATABASE_URL es obligatoria y debe usar el endpoint pooled de
# Neon (`-pooler` en el hostname). El backend limita cada proceso a 4 conexiones.
# NODE_ENV=production

# Clave de OpenRouter (IA GLM-5.2: tabulacion descriptiva, generador de
# titulos, matriz de consistencia y humanizador).
OPENROUTER_API_KEY=

# Overrides opcionales del Humanizador (por defecto usa el modelo global y
# 12000 tokens de salida por bloque).
# OPENROUTER_MODEL_HUMANIZADOR=z-ai/glm-5.2
# OPENROUTER_MAX_TOKENS_HUMANIZADOR=12000

# Pre-busqueda del generador de titulos (opcional pero recomendado):
# Brave Search API (plan gratis: 2000 consultas/mes, 1/seg) - motor principal.
BRAVE_API_KEY=
# Firecrawl (plan gratis: ~500 creditos UNICOS) - solo respaldo si Brave falla.
FIRECRAWL_API_KEY=

# ── Almacenamiento de archivos (Cloudflare R2) ──────────────────────────────
# Genera un token "Object Read & Write" acotado exclusivamente al bucket.
# NO uno "Admin Read & Write": ese puede borrar buckets enteros si se filtra.
# R2_ACCOUNT_ID=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# ARTIFACT_RETENTION_DAYS=30
# ARTIFACT_SIGNED_URL_SECONDS=300
# R2_READINESS_CACHE_SECONDS=60

# ── Pagos en PEN (Taypi) ────────────────────────────────────────────────────
# Solo un webhook HMAC válido acredita saldo o plan.
# TAYPI_PUBLIC_KEY=
# TAYPI_SECRET_KEY=
# TAYPI_WEBHOOK_SECRET=
# TAYPI_SANDBOX=true
# Timeout por intento contra Taypi (entre 3000 y 30000 ms).
# TAYPI_TIMEOUT_MS=10000
# Precio en centimos de PEN por respuesta para recargas de cualquier cantidad.
# Debe definirse antes de habilitar recargas o lanzamiento comercial.
# FORMS_RESPONSE_PRICE_CENTS=

# Forms: en producción enumera Vercel y el origen chrome-extension:// exacto.
# No uses "*" una vez instalado el paquete definitivo de la extensión.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tabulacion.vercel.app,chrome-extension://kdppbednjfajcjogdajmagfabidfjmem

# Worker Forms separado (Render). El API usa TESISTAB_RUN_JOBS_INLINE=false.
# TESISTAB_WORKER_MODE=true
# TESISTAB_RUN_JOBS_INLINE=false
# TESISTAB_JOB_BATCH_SIZE=100
# TESISTAB_JOB_LEASE_MS=30000
# TESISTAB_SETTLEMENT_RETRIES=3
# TESISTAB_SETTLEMENT_RETRY_DELAY_MS=250
# FORMS_WORKER_ADAPTER=node_app/forms-worker-adapter.js
# Umbral operativo de /ready para dejar de aceptar mas cola Forms.
# FORMS_READY_MAX_QUEUE=10000
# Fin de la ventana de compatibilidad de endpoints antiguos (RFC 3339).
# LEGACY_API_SUNSET_AT=2026-09-07T00:00:00Z

# Gates operativos. Una migración de producción exige un respaldo lógico ya
# generado y una referencia verificable (fecha/ID/ruta del respaldo).
# COMMERCIAL_LAUNCH_ENABLED=false
# Aunque existan credenciales Taypi, el checkout publico permanece apagado
# hasta que este gate sea true Y TAYPI_SANDBOX sea false. Los webhooks siguen
# verificandose para no perder la confirmacion de una orden ya emitida.
# NEON_BACKUP_CONFIRMED=false
# NEON_BACKUP_REFERENCE=
# NEON_STAGING_BRANCH_CONFIRMED=false
# R2_BUCKET_SCOPE_CONFIRMED=false
# R2_LIFECYCLE_CONFIRMED=false
# RENDER_REQUIRED_CHECKS_CONFIRMED=false
# RENDER_STARTER_SERVICES_CONFIRMED=false
