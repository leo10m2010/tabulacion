{
  "name": "TesisHub Forms",
  "description": "Automatiza respuestas en tus propios Google Forms con perfiles, distribuciones y control de progreso.",
  "version": "1.6.0",
  "manifest_version": 3,
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://tabulacion-api.onrender.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/forms/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"]
    }
  ]
}
